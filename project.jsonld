      ]
    },
    {
      "@id": "card_5643ff26-50d0-4325-aaec-ed6b1b15e81f",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Personal Stakes Drive Decisions",
      "description": "People weigh public issues against their own experiences and perceived risks before deciding how to respond. As personal consequences become more salient, they shape both what people believe and whether they take action.\n",
      "x": 397.03102978368577,
      "y": -157.92602648530283,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
