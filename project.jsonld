      ]
    },
    {
      "@id": "card_94c5c9aa-11a1-4a9e-8fed-3958c4b44839",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Bounded Public Awareness",
      "description": "Communities experiencing harm may struggle to gain recognition when outsiders rely on narrow geographic, social, or identity-based frames to determine what issues matter. This limits who recognizes the need and reduces broader engagement with the community’s concerns.",
      "x": 1780.2248413559214,
      "y": 282.7870229850307,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
