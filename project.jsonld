    {
      "@id": "card_f3fb6761-9d96-4ea4-9e3c-802602c71a5a",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "Personal Stakes Drive Participation",
      "description": "People deciding whether to engage with public issues often assess whether those issues have direct consequences for their lives. When an issue feels distant, abstract, or relevant only to others, they are less likely to move from awareness into action, narrowing participation.\n",
      "x": 1455.4353733072223,
      "y": -501.667054814971,
      "w": 300,
      "h": 150,
      "cardType": null,
      "locked": false,
