    },
    {
      "@id": "card_686dd963-ac6d-4589-82e3-2e1c610a84fa",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "Fear Filters Public Participation",
      "description": "People who consider speaking or acting on public issues filter their engagement through fears of social consequences, especially when negative reactions can spread quickly through social networks. This fear narrows who feels able to participate and what perspectives are expressed.\n",
      "x": 485.56184319036237,
      "y": -517.2012091718973,
