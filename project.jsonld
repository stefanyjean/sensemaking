      ]
    },
    {
      "@id": "card_1e1bf6b9-ab3e-4f2f-b962-726dd9fce5a1",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Fear Silences Participation",
      "description": "People who want to speak or act are constrained when social consequences feel personally threatening. Rapid spread of negative messaging through social media amplifies the perceived risk of public shaming, rejection, or dehumanization, reducing willingness to engage.\n",
      "x": 1385.30095808696,
      "y": -132.55167108819393,
      "w": 280,
