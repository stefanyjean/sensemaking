        "item_c06a0d43-2d0c-40cd-8bf9-9fb7d81bc69c",
        "item_44352eff-d6a2-462e-a4dc-bc444f475aef"
      ]
    },
    {
      "@id": "card_960279a8-de59-434d-8931-f5b3b894bc0d",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Public Understanding Gap",
      "description": "People may lack the foundational knowledge and reading ability required to make sense of complex issues, creating a disconnect between public conversations and individual understanding. This can leave communities with uneven awareness of issues affecting them.\n",
      "x": 571.4589196629095,
      "y": 663.9315804610196,
      "w": 280,
      "h": 150,
