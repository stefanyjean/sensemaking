        "card_686dd963-ac6d-4589-82e3-2e1c610a84fa"
      ]
    },
    {
      "@id": "card_0c840225-95f8-47c8-981b-e12c2584c9a6",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Limited Capacity for Civic Participation",
      "description": "Individuals who may want to participate are constrained by competing demands on their time, making civic involvement harder to prioritize. The consequence is lower turnout and reduced participation in community and electoral processes.\n",
      "x": 2192.861322237715,
      "y": 907.024683652265,
