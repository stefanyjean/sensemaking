    {
      "@id": "card_d1927c3f-7b99-4af0-91b2-b5f0a33781b4",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Engagement Requires Personal Relevance",
      "description": "Potential participants evaluate whether an issue applies to them before deciding to act. Issues perceived as affecting only a limited group attract narrower participation, while personally consequential issues change behavior through heightened perceived risk.",
      "x": 1919.4846358856598,
      "y": -358.0972603567553,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
