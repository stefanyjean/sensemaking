        "card_d1927c3f-7b99-4af0-91b2-b5f0a33781b4",
        "card_c998a598-8786-4cf3-b8f2-c0670e784ccd"
      ]
    },
    {
      "@id": "card_38a88587-5d35-4363-b798-a8023ef670c7",
      "@type": "tg:Theme",
      "type": "Theme",
      "tier": 3,
      "title": "Participation Depends on Personal Risk",
      "description": "People deciding whether to engage in public issues weigh participation against perceived personal consequences, including whether an issue affects their lives or exposes them to social harm. When risks feel distant or threatening, they narrow their involvement and withdraw from public action.\n",
      "x": 1028.9412649075553,
      "y": -569.1528363918735,
      "w": 340,
      "h": 150,
      "cardType": null,
      "locked": false,
